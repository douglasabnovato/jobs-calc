<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('parts/head', { title: 'Adicionar novo job', page: 'job' }) %>
</head>
<body id="page-job">
  <%- include('parts/page-header', { title: 'Adicionar novo job' }) %>
  <div class="container flex animate-up delay-2">
    <main>
      <form id="form-job" method="post" action="/job" novalidate>
        <fieldset>
          <legend>Dados do job</legend>
          <div class="separator light"></div>
          <% if (Object.keys(errors).length) { %><p class="form-alert" role="alert">Revise os campos destacados.</p><% } %>
          <%- include('parts/field', { name: 'name', label: 'Nome do job', type: 'text', value: form.name || '', required: true, error: errors.name }) %>
          <div class="input-group">
            <%- include('parts/field', { name: 'daily-hours', label: 'Quantas horas <br/>por dia vai dedicar ao job?', type: 'text', inputmode: 'decimal', value: form['daily-hours'] || '', required: true, error: errors['daily-hours'] }) %>
            <%- include('parts/field', { name: 'total-hours', label: 'Estimativa de <br/>horas para esse job?', type: 'text', inputmode: 'decimal', value: form['total-hours'] || '', required: true, error: errors['total-hours'] }) %>
          </div>
        </fieldset>
      </form>
    </main>
    <aside class="card">
      <img src="/images/money-gray.svg" alt="" />
      <p>Preencha os dados ao lado para ver o valor do projeto</p>
      <div class="button-group">
        <button class="button green" form="form-job" type="submit">Salvar</button>
        <a href="/" class="button gray"><img src="/images/trash-24.svg" alt="Cancelar cadastro" /></a>
      </div>
    </aside>
  </div>
</body>
</html>
