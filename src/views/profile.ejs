<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('parts/head', { title: 'Meu perfil', page: 'profile' }) %>
</head>
<body id="page-profile">
  <%- include('parts/page-header', { title: 'Meu perfil' }) %>
  <% const f = form || { name: profile.name, avatar: profile.avatar, 'monthly-budget': (profile.monthlyBudgetCents / 100).toFixed(2).replace('.', ','), 'hours-per-day': String(profile.hoursPerDay).replace('.', ','), 'days-per-week': profile.daysPerWeek, 'vacation-per-year': profile.vacationPerYear }; %>
  <div class="container animate-up delay-2">
    <aside class="card">
      <% if (profile.avatar) { %><img src="<%= profile.avatar %>" alt="" /><% } %>
      <h2><%= profile.name %></h2>
      <p>O valor da sua hora é <br /><strong><%= formatBRL(hourCents) %></strong></p>
      <button class="button green" form="form-profile" type="submit">Salvar dados</button>
    </aside>
    <main>
      <% if (flash) { %><p class="flash" role="status">Perfil salvo. O valor da hora foi recalculado.</p><% } %>
      <form id="form-profile" method="post" action="/profile" novalidate>
        <fieldset>
          <legend>Dados do perfil</legend>
          <div class="separator light"></div>
          <% if (Object.keys(errors).length) { %><p class="form-alert" role="alert">Revise os campos destacados.</p><% } %>
          <div class="input-group">
            <%- include('parts/field', { name: 'name', label: 'Nome', type: 'text', value: f.name, required: true, error: errors.name }) %>
            <%- include('parts/field', { name: 'avatar', label: 'Link da foto (https://, opcional)', type: 'url', value: f.avatar, required: false, error: errors.avatar }) %>
          </div>
        </fieldset>
        <fieldset>
          <legend>Planejamento</legend>
          <div class="separator light"></div>
          <div class="input-group">
            <%- include('parts/field', { name: 'monthly-budget', label: 'Quanto eu <br/>quero ganhar por mês? (R$)', type: 'text', inputmode: 'decimal', value: f['monthly-budget'], required: true, error: errors['monthly-budget'] }) %>
            <%- include('parts/field', { name: 'hours-per-day', label: 'Quantas horas <br/>quero trabalhar por dia?', type: 'text', inputmode: 'decimal', value: f['hours-per-day'], required: true, error: errors['hours-per-day'] }) %>
          </div>
          <div class="input-group">
            <%- include('parts/field', { name: 'days-per-week', label: 'Quantos dias <br/>quero trabalhar por semana?', type: 'number', value: f['days-per-week'], required: true, error: errors['days-per-week'] }) %>
            <%- include('parts/field', { name: 'vacation-per-year', label: 'Quantas semanas <br/>por ano quero de férias?', type: 'number', value: f['vacation-per-year'], required: true, error: errors['vacation-per-year'] }) %>
          </div>
        </fieldset>
      </form>
    </main>
  </div>
</body>
</html>
