<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('parts/head', { title: 'Painel', page: 'index' }) %>
  <script src="/scripts/index.js" defer type="module"></script>
</head>
<body id="page-index">
  <header class="page-header">
    <div class="container">
      <section id="top" class="animate-up">
        <img id="logo" src="/images/logo.svg" alt="JobsCalc" />
        <span id="notification" role="status">
          <img src="/images/alert-octagon.svg" alt="" />
          <% if (freeHours === 0) { %>Você preencheu toda sua agenda.
          <% } else if (freeHours > 0) { %>Você tem <%= String(freeHours).replace('.', ',') %> horas livres no seu dia.
          <% } else { %>Você tem <%= String(-freeHours).replace('.', ',') %> horas extras na sua agenda.<% } %>
        </span>
        <a href="/profile" id="avatar-profile">
          <p><%= profile.name %> <span>Ver perfil</span></p>
          <% if (profile.avatar) { %><img src="<%= profile.avatar %>" alt="" /><% } %>
        </a>
      </section>
      <div class="separator"></div>
      <section id="summary" class="animate-up delay-1" aria-labelledby="resumo">
        <h2 id="resumo" class="sr-only">Resumo</h2>
        <div class="info">
          <div class="total"><strong><%= count.total %></strong> Projetos ao total</div>
          <div class="in-progress"><strong><%= count.progress %></strong> Em andamento</div>
          <div class="finished"><strong><%= count.done %></strong> Encerrados</div>
        </div>
        <a class="button orange" href="/job"><span><img src="/images/plus-24.svg" alt="" /></span>Adicionar novo job</a>
      </section>
    </div>
  </header>

  <div class="container">
    <main class="animate-up delay-2">
      <h1 class="sr-only">Trabalhos</h1>
      <% if (flash) { %>
        <p class="flash" role="status"><%= { criado: 'Job criado.', excluido: 'Job excluído.' }[flash] || 'Pronto.' %></p>
      <% } %>
      <% if (jobs.length === 0) { %>
        <p class="empty">Nenhum job cadastrado. Clique em “Adicionar novo job” para calcular o primeiro orçamento.</p>
      <% } %>
      <ul class="cards">
        <% jobs.forEach((job) => { %>
          <li class="card <%= job.status %>" data-id="<%= job.id %>" data-name="<%= job.name %>">
            <div class="id column"><%= job.id %></div>
            <div class="name column"><%= job.name %></div>
            <div class="deadline column">
              <span>Prazo</span>
              <p><%= job.status === 'progress' ? `${job.remaining} ${job.remaining === 1 ? 'dia' : 'dias'} para a entrega` : 'Prazo encerrado' %></p>
            </div>
            <div class="amount column">
              <span>Valor</span>
              <p><%= formatBRL(job.budgetCents) %></p>
            </div>
            <div class="status badge column"><%= job.status === 'done' ? 'Encerrado' : 'Em andamento' %></div>
            <div class="actions column flex">
              <a href="/job/<%= job.id %>" class="button white edit"><img src="/images/edit-24.svg" alt="Editar <%= job.name %>" /></a>
              <button type="button" class="delete button white"><img src="/images/trash-24.svg" alt="Excluir <%= job.name %>" /></button>
            </div>
          </li>
        <% }) %>
      </ul>
    </main>
  </div>
  <%- include('parts/delete-modal', { action: '/job/delete/0' }) %>
</body>
</html>
