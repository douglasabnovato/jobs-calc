<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('parts/head', { title: 'Editar job', page: 'job' }) %>
  <script type="module" src="/scripts/job-edit.js"></script>
</head>
<body id="page-job-edit">
  <%- include('parts/page-header', { title: 'Editar job' }) %>
  <% const f = form || { name: job.name, 'daily-hours': String(job.dailyHours).replace('.', ','), 'total-hours': String(job.totalHours).replace('.', ',') }; %>
  <div class="container flex animate-up delay-2">
    <main>
      <% if (flash) { %><p class="flash" role="status">Alterações salvas.</p><% } %>
      <form id="form-job" method="post" action="/job/<%= job.id %>" novalidate>
        <fieldset>
          <legend>Dados do job</legend>
          <div class="separator light"></div>
          <% if (Object.keys(errors).length) { %><p class="form-alert" role="alert">Revise os campos destacados.</p><% } %>
          <%- include('parts/field', { name: 'name', label: 'Nome do job', type: 'text', value: f.name, required: true, error: errors.name }) %>
          <div class="input-group">
            <%- include('parts/field', { name: 'daily-hours', label: 'Quantas horas <br/>por dia vai dedicar ao job?', type: 'text', inputmode: 'decimal', value: f['daily-hours'], required: true, error: errors['daily-hours'] }) %>
            <%- include('parts/field', { name: 'total-hours', label: 'Estimativa de <br/>horas para esse job?', type: 'text', inputmode: 'decimal', value: f['total-hours'], required: true, error: errors['total-hours'] }) %>
          </div>
        </fieldset>
      </form>
    </main>
    <aside class="card">
      <img src="/images/money-color.svg" alt="" />
      <p>O valor do projeto ficou em <strong><%= formatBRL(budget) %></strong></p>
      <div class="button-group">
        <button class="button green" form="form-job" type="submit">Salvar</button>
        <button type="button" class="button gray open-modal"><img src="/images/trash-24.svg" alt="Excluir job" /></button>
      </div>
    </aside>
  </div>
  <%- include('parts/delete-modal', { action: '/job/delete/' + job.id }) %>
</body>
</html>
